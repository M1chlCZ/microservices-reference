# Development configuration. The passwords are local development values only.
# The compose file sets the same values for its containers.

# Internal gRPC targets used by the calling services.
INVENTORY_GRPC=localhost:9082
PAYMENTS_GRPC=localhost:9086
ORDERS_GRPC=localhost:9081
NOTIFICATIONS_GRPC=localhost:9083
SHIPPING_GRPC=localhost:9087
INVOICING_GRPC=localhost:9088

# Internal gRPC mTLS (optional). Generate the files with `make certs`. A
# service that serves gRPC needs the server pair; a service that dials other
# services needs the client pair; both verify their peer with the CA bundle.
# GRPC_TLS_CA=deploy/certs/ca.crt
# GRPC_TLS_SERVER_CERT=deploy/certs/server.crt
# GRPC_TLS_SERVER_KEY=deploy/certs/server.key
# GRPC_TLS_CLIENT_CERT=deploy/certs/client.crt
# GRPC_TLS_CLIENT_KEY=deploy/certs/client.key

# Tracing (optional, disabled by default): none, stdout or otlp. The OTLP
# exporter reads its endpoint from OTEL_EXPORTER_OTLP_ENDPOINT.
# OTEL_TRACES_EXPORTER=stdout
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=orders

# Orders service
ORDERS_DATABASE_URL=postgres://orders_app:orders-app-dev@localhost:5432/orders_db
ORDERS_MIGRATOR_URL=postgres://orders_migrator:orders-migrator-dev@localhost:5432/orders_db
ORDERS_OWNER_ROLE=orders_owner
ORDERS_ADDR=:8081
ORDERS_GRPC_ADDR=:9081

# Inventory service
INVENTORY_DATABASE_URL=postgres://inventory_app:inventory-app-dev@localhost:5432/inventory_db
INVENTORY_MIGRATOR_URL=postgres://inventory_migrator:inventory-migrator-dev@localhost:5432/inventory_db
INVENTORY_OWNER_ROLE=inventory_owner
INVENTORY_ADDR=:8082
INVENTORY_GRPC_ADDR=:9082

# Notifications service
NOTIFICATIONS_DATABASE_URL=postgres://notifications_app:notifications-app-dev@localhost:5432/notifications_db
NOTIFICATIONS_MIGRATOR_URL=postgres://notifications_migrator:notifications-migrator-dev@localhost:5432/notifications_db
NOTIFICATIONS_OWNER_ROLE=notifications_owner
NOTIFICATIONS_ADDR=:8083
NOTIFICATIONS_GRPC_ADDR=:9083

# Identity service
IDENTITY_DATABASE_URL=postgres://identity_app:identity-app-dev@localhost:5432/identity_db
IDENTITY_MIGRATOR_URL=postgres://identity_migrator:identity-migrator-dev@localhost:5432/identity_db
IDENTITY_OWNER_ROLE=identity_owner
IDENTITY_ADDR=:8084
IDENTITY_GRPC_ADDR=:9084

# Catalog service
CATALOG_DATABASE_URL=postgres://catalog_app:catalog-app-dev@localhost:5432/catalog_db
CATALOG_MIGRATOR_URL=postgres://catalog_migrator:catalog-migrator-dev@localhost:5432/catalog_db
CATALOG_OWNER_ROLE=catalog_owner
CATALOG_ADDR=:8085
CATALOG_GRPC_ADDR=:9085

# Payments service
PAYMENTS_DATABASE_URL=postgres://payments_app:payments-app-dev@localhost:5432/payments_db
PAYMENTS_MIGRATOR_URL=postgres://payments_migrator:payments-migrator-dev@localhost:5432/payments_db
PAYMENTS_OWNER_ROLE=payments_owner
PAYMENTS_ADDR=:8086
PAYMENTS_GRPC_ADDR=:9086

# Shipping service
SHIPPING_DATABASE_URL=postgres://shipping_app:shipping-app-dev@localhost:5432/shipping_db
SHIPPING_MIGRATOR_URL=postgres://shipping_migrator:shipping-migrator-dev@localhost:5432/shipping_db
SHIPPING_OWNER_ROLE=shipping_owner
SHIPPING_ADDR=:8087
SHIPPING_GRPC_ADDR=:9087
SHIPPING_CARRIER=generic

# Invoicing service
INVOICING_DATABASE_URL=postgres://invoicing_app:invoicing-app-dev@localhost:5432/invoicing_db
INVOICING_MIGRATOR_URL=postgres://invoicing_migrator:invoicing-migrator-dev@localhost:5432/invoicing_db
INVOICING_OWNER_ROLE=invoicing_owner
INVOICING_ADDR=:8088
INVOICING_GRPC_ADDR=:9088

# Gateway example
GATEWAY_ADDR=:8090
